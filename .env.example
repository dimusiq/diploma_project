# Скопируйте в .env и подставьте свои значения:
#   cp .env.example .env
#
# Генерация секретов (SECRET_KEY, пароли):
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Плейсхолдер changethis допустим только при ENVIRONMENT=local
# (предупреждение). Для staging/production приложение не стартует.

# Domain
DOMAIN=localhost
# DOMAIN=localhost.tiangolo.com

FRONTEND_HOST=http://localhost:5173
# FRONTEND_HOST=https://dashboard.example.com

# local | staging | production
ENVIRONMENT=local

PROJECT_NAME="Склад"
STACK_NAME=sklad

# Backend
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,https://localhost,https://localhost:5173,http://localhost.tiangolo.com"
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Emails
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# Postgres — один блок (без дублей ключей).
# uvicorn на хосте → localhost; docker-compose.yml для backend/worker задаёт POSTGRES_SERVER=db.
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis
POSTGRES_DB=app

SENTRY_DSN=

# LLM (опционально)
VLLM_BASE_URL=http://host.docker.internal:8001
VLLM_CHAT_MODEL=Qwen/Qwen3-8B-AWQ
VLLM_REASONING_MODEL=Qwen/Qwen3-8B-AWQ
AGENT_LLM_TIMEOUT_SEC=180
AGENT_CODE_ORCHESTRATION=true

DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend
